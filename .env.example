# Copy to .env.local for local development, and add the same values in
# Vercel → Project → Settings → Environment Variables. Never commit real values.

# MySQL 8.0+
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=whatsapp_app
DB_PASSWORD=replace-with-a-strong-password
DB_NAME=whatsapp
# Keep small on serverless (each function instance opens its own pool).
DB_POOL_SIZE=3

# Generate each with: openssl rand -hex 32
SESSION_SECRET=replace-with-64-hex-chars
TOKEN_ENCRYPTION_KEY=replace-with-64-hex-chars

# Meta app (developers.facebook.com → your app → App settings → Basic)
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
NEXT_PUBLIC_META_APP_ID=your-meta-app-id
# Only needed for Embedded Signup (per-workspace connections).
NEXT_PUBLIC_META_CONFIG_ID=
NEXT_PUBLIC_META_GRAPH_API_VERSION=v23.0
META_GRAPH_API_VERSION=v23.0
# Any random string; paste the same value in Meta → WhatsApp → Configuration.
META_WEBHOOK_VERIFY_TOKEN=replace-with-a-random-string

# Server-managed WhatsApp connection (WhatsApp → API Setup in the Meta app).
# Use a System User token (never expires) with whatsapp_business_messaging
# and whatsapp_business_management.
PLATFORM_WHATSAPP_ACCESS_TOKEN=replace-with-system-user-token
PLATFORM_WHATSAPP_WABA_ID=your-whatsapp-business-account-id
PLATFORM_WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
PLATFORM_WHATSAPP_DISPLAY_PHONE_NUMBER=

# Webhooks: delivery receipts, replies/STOP opt-outs and template approvals.
# Meta signs every webhook with META_APP_SECRET; unsigned requests are rejected.
# Callback URL: https://<your-domain>/api/whatsapp/webhook
# Fields: messages, message_template_status_update, template_category_update.

# Background sending. Required: chained serverless runs authenticate with it.
# On Vercel the in-process worker switches itself off; sending runs in short
# chained invocations (see README → Deploying on Vercel).
CRON_SECRET=replace-with-a-random-string
# Optional: public URL for chained runs (defaults to the Vercel production URL).
APP_URL=
QUEUE_TIME_BUDGET_MS=45000
QUEUE_POLL_INTERVAL_MS=5000
SEND_CONCURRENCY=10
DISABLE_QUEUE_WORKER=

# Developer API: requests per minute per API key.
API_RATE_LIMIT_PER_MINUTE=600

# Local testing only: allow http:// and private-network webhook URLs for
# outbound events. Never set this in production.
WEBHOOK_ALLOW_INSECURE_URLS=

# Local testing only: accept unsigned webhooks (ignored in production).
WEBHOOK_SKIP_SIGNATURE=
